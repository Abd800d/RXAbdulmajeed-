# Public client configuration. The Supabase anon key is intentionally public and protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional custom source-grounded AI proxy when Supabase Edge Functions are not used.
VITE_APH_AI_ENDPOINT=

# SERVER / SUPABASE EDGE SECRETS — never prefix these with VITE_ and never embed them in an APK.
# Configure with: supabase secrets set OPENAI_API_KEY=... GEMINI_API_KEY=...
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/import-to-supabase.mjs on a trusted admin machine.
SUPABASE_URL=
